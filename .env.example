# ApplyPilot Environment Configuration
# Copy to ~/.applypilot/.env and fill in your values.

# LLM Provider (pick one, or use gateway below)
GEMINI_API_KEY=           # Gemini 2.5 Flash (recommended, free tier)
# OPENAI_API_KEY=         # OpenAI (GPT-4.1 Nano)
# ANTHROPIC_API_KEY=      # Anthropic (Claude Haiku)
# DEEPSEEK_API_KEY=       # DeepSeek (budget fallback)
# NVIDIA_NIM_API_KEY=     # NVIDIA Build / hosted NIM (free hosted endpoints)
# OPENCODE_ZEN_API_KEY=   # OpenCode Zen free-tier gateway
# OPENROUTER_API_KEY=     # OpenRouter (free-tier: 20 RPM shared, 50/1000 RPD)
# OPENROUTER_MANAGEMENT_API_KEY=  # OpenRouter management key (auto-detect $10+ credit tier)
# LLM_URL=http://127.0.0.1:8080/v1  # Local LLM (llama.cpp, Ollama)
# LLM_MODEL=              # Override fast model name
# LLM_MODEL_QUALITY=      # Override quality model name (tailoring, cover letters)

# LiteLLM gateway multi-key rotation (see docs/guides/litellm-multi-provider.md)
# OPENCODE_ZEN_API_BASE=https://opencode.ai/zen/v1
# ZEN_KEY_1=              # 7 ZEN free-tier keys (ZEN_KEY_1..ZEN_KEY_7)
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# GEMINI_KEY_1=           # 7 Gemini keys for browser-gemini lanes (GEMINI_KEY_1..7)
# VERCEL_API_BASE=        # your per-project Vercel AI Gateway base URL
# VERCEL_KEY_1=           # 7 Vercel auth keys (VERCEL_KEY_1..7)
# OPENROUTER_KEY_1=sk-or-v1-...          # 7 OpenRouter keys for lanes (OPENROUTER_KEY_1..7)
# MISTRAL_API_KEY=          # Mistral primary key (free tier; $10/mo included credit, org-scoped limits)
# MISTRAL_ADMIN_API_KEY=    # Mistral Admin key (optional; /v1/admin/rate-limit for org RPS/TPM)
# MISTRAL_KEY_1=            # 7 Mistral keys for lanes (MISTRAL_KEY_1..7) — org-scoped, do NOT multiply limits
# GROQ_API_KEY=gsk_...      # GroqCloud primary key (Free plan; hard RPM/RPD/TPM/TPD/ASH/ASD quotas, no monthly dollar credit)
# GROQ_KEY_1=               # 7 Groq keys for lanes (GROQ_KEY_1..7) — each presumed a separate Groq org; verify
# KILO_API_KEY=             # Kilo Code AI Gateway primary key (200 req/hour/IP free quota shared per IP; /models needs no key)
# KILO_KEY_1=               # 7 Kilo keys for lanes (KILO_KEY_1..7) — quota is shared per IP, keys do NOT create buckets
# CLOUDFLARE_ACCOUNT_ID=    # Cloudflare account id (required with token for /ai/models/search catalog refresh)
# CLOUDFLARE_API_TOKEN=     # Workers AI Read/Write token — 10,000 Neurons/day/account shared free budget, reset 00:00 UTC
# CLOUDFLARE_WORKERS_AI_OPENAI_BASE=https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/ai/v1
# CLOUDFLARE_KEY_1=         # 7 Cloudflare tokens for lanes (CLOUDFLARE_KEY_1..7) — each presumed a separate account; the 10K/day/N budget is per account
# SILICONFLOW_API_KEY=sk-...   # SiliconFlow free models cost zero; rate limits account-level, fixed per model, independent (not a shared pool)
# SILICONFLOW_KEY_1=           # 7 SiliconFlow keys for lanes (SILICONFLOW_KEY_1..7) — each presumed a separate account; quotas are per-account
# SENSENOVA_API_KEY=sk-...     # SenseNova global (token.sensenova.ai) — 1,500 calls/model/5h sliding window, $0 public beta; SENSENOVA_REGION=cn for token.sensenova.cn
# SENSENOVA_KEY_1=             # 7 SenseNova keys for lanes (SENSENOVA_KEY_1..7) — each presumed a separate account; quota is per model, not a shared pool
# ZAI_API_KEY=sk-...           # Z.AI (api.z.ai/api/paas/v4) — glm-4.7-flash (200K ctx), glm-4.5-flash (128K), glm-4.6v-flash (multimodal) are $0 input+output; Web Search tool is $0.01/use; rate limits are account-specific (z.ai/manage-apikey)
# ZAI_KEY_1=                   # 7 Z.AI keys for lanes (ZAI_KEY_1..7) — each a separate account; account-specific rate limits, not a shared pool
# AGNES_API_KEY=sk-...         # Agnes AI (apihub.agnes-ai.com/v1) — free/default tier: 20 actual executable text RPM (30 public), image/video per-resolution; no public hard RPD; paid Token Plans (Starter $4 1,500/5h) recorded separately
# AGNES_KEY_1=                 # 7 Agnes keys for lanes (AGNES_KEY_1..7) — same key type SHARES one pool; multiple free keys do NOT multiply quota (verify each, then rotate)
# ORCAROUTER_API_KEY=or-...    # OrcaRouter (api.orcarouter.ai/v1) — free = rate-constrained pool (NO consumable RPD/monthly allowance; 429 + Retry-After, restores automatically); orcarouter/free is a difficulty-routed $0 virtual model; deepseek/deepseek-v4-flash-free (1M ctx), qwen/qwen3.8-27b-free are the concrete free aliases
# ORCAROUTER_KEY_1=            # 7 OrcaRouter keys for lanes (ORCAROUTER_KEY_1..7) — keys SHARE the workspace pool; they do NOT multiply quota, and the Hacker plan ships 3 keys (verify each, then rotate); workspace rate grows with lifetime paid
# REQUESTY_API_KEY=req_...     # Requesty (router.requesty.ai/v1; EU variant router.eu.requesty.ai/v1, OpenAI-compatible) — Free plan: hard 200 requests/day (resets daily, exact clock NOT publicly documented), $0, no credit card; no general gateway RPM/TPM (upstream provider 429s can still occur); 12 current zero-cost routes, provider-pinned by default in LiteLLM
# REQUESTY_KEY_1=              # 7 Requesty keys for lanes (REQUESTY_KEY_1..7) — each verified individually; 200/day is a plan allowance (NOT per-key RPM), so don't treat lanes as quota multiplication
# POOLSIDE_API_KEY=plsid_...   # Poolside (inference.poolside.ai/v1, OpenAI-compatible) — CURRENT OFFER: temporary zero-cost preview ("Free to use for a limited time"): Laguna S 2.1 (1M ctx) / XS 2.1 (256K); NOT a permanent free tier; no universal RPM/RPD/TPM/monthly quota/reset clock published (limits account-specific; Poolside raises them on request) — revalidate before building capacity
# POOLSIDE_KEY_1=              # 7 Poolside keys for lanes (POOLSIDE_KEY_1..7) — each verified individually; M.1 free status is NOT auto-carried forward (May-2026 promo ended on the models page)
# OPENXLAB_INTERN_API_KEY=     # OpenXLab Intern/浦语 ChatAPI (intern.openxlab.org.cn/api/v1, OpenAI-compatible) — public default 30 RPM/user (higher on request), NO universal TPM/RPD/monthly quota published (-20053 = req/min OR token/min frequency); BILLING NOT DOCUMENTED → strict-$0 router must wait for account confirmation (then run update_openxlab_intern_free_models.py --billing-mode free); Intern token valid 6 months (Bearer auth); generic OpenXLab AK/SK is a separate credential
# OPENXLAB_INTERN_KEY_1=       # 14 OpenXLab Intern keys for lanes (OPENXLAB_INTERN_KEY_1..14) — each verified individually; prefer pinned versions, *-latest aliases resolve ref_model live; 30 RPM/user is PER USER — many keys on ONE account do NOT multiply quota (verify per-token scope)
# LITELLM_MASTER_KEY=applypilot-local

# Optional: route all LLM traffic through LiteLLM gateway
# See docs/guides/litellm-multi-provider.md
# LLM_URL=http://127.0.0.1:4000/v1
# LLM_API_KEY=applypilot-local
# LLM_MODEL=fast
# LLM_MODEL_QUALITY=quality

# Auto-Apply agent runtime
# BROWSEROS_MCP_URL=  # Optional override; mcporter/editor BrowserOS config is discovered automatically
APPLYPILOT_BROWSER_RUNTIME=auto  # auto | browseros | playwright

# Optional: route auto-apply through LiteLLM gateway
# APPLYPILOT_AGENT_BASE_URL=http://127.0.0.1:4000
# APPLYPILOT_AGENT_API_KEY=applypilot-local
# APPLYPILOT_AGENT_MODEL=sonnet
# ANTHROPIC_DEFAULT_SONNET_MODEL=quality
# ANTHROPIC_DEFAULT_HAIKU_MODEL=fast

# Proxy (optional, for scraping)
# PROXY=host:port:user:pass

# FreeHire discovery (public API; key is optional)
FREEHIRE_ENABLED=true
FREEHIRE_API_URL=
FREEHIRE_TOKEN=
FREEHIRE_API_KEY=

# Free/local source integration (docs/free-sources/README.md).
# Existing LLM_URL is reused; the gateway must expose ApplyPilot workload aliases.
# No Exa, PDL, Unipile, Firecrawl, or metered X data API keys are used here.
# APPLYPILOT_SEARCH_BACKEND=ddgs  # auto | ddgs | searxng
# SEARXNG_URL=http://127.0.0.1:8888
# APPLYPILOT_CRAWLER=auto        # http | playwright (isolated browser SDK)
# Optional worker overrides; otherwise ~/.applypilot/tools/<name>/bin/python:
# APPLYPILOT_DDGS_PYTHON=
# APPLYPILOT_CRAWL4AI_PYTHON=
# APPLYPILOT_TWIKIT_PYTHON=
# APPLYPILOT_TWSCRAPE_PYTHON=
# APPLYPILOT_LINKEDIN_SCRAPER_PYTHON=
# Session FILE paths only; do not put raw credentials in discovery YAML:
# APPLYPILOT_TWIKIT_COOKIES=/absolute/private/path/x-cookies.json
# APPLYPILOT_TWSCRAPE_DB=/absolute/private/path/authorized-x-accounts.db
# APPLYPILOT_LINKEDIN_SESSION=/absolute/private/path/linkedin-session.json
# APPLYPILOT_LINKEDIN_RS_BIN=/absolute/path/to/li
# APPLYPILOT_MCP_CONFIG=/absolute/private/path/free_sources_mcp.json
# XACTIONS_SESSION_COOKIE=   # local XActions only; your own authorized session
# Optional post-enrichment research: off by default; its OWN capped budget.
# APPLYPILOT_RESEARCH_ON_ENRICH=1  # Already enabled; normal controls are in the dashboard
# APPLYPILOT_RESEARCH_COMPANIES=-1  # Optional override: -1 uncapped, 0 paused, positive cap; dashboard preferred

# Unattended routine research, outreach and replies are enabled once with:
# applypilot autopilot --enable-outreach --x https://x.com/YOUR_HANDLE
# Then use plain `applypilot autopilot`; cap changes: --outreach-limit 30.
# Initial automatic requests allow a 180s veto; applications do not wait for it.
# Private owner-controlled HTTPS webhook accepting {"text":"..."}.
# Without this, exception notifications are local-only.
# APPLYPILOT_ALERT_WEBHOOK=https://YOUR_PRIVATE_NOTIFICATION_ENDPOINT
# BrowserOS neo is required for the new social path. Copy its actual local MCP
# endpoint above; the historical 9012 example is not a universal port.

# Optional private GitHub workspace backups (website: Backups & recovery).
# Fine-grained token: one selected PRIVATE repository, Contents read/write.
# Separate from the existing read-only GitHub evidence token.
APPLYPILOT_BACKUP_TOKEN=
# Backup access uses your private GitHub account; there is no recovery-key setting.

# Local services run alongside LiteLLM; explicit paths/sessions still take precedence.
APPLYPILOT_SOURCE_RUNTIME=auto
APPLYPILOT_GMAIL_RUNTIME=auto
APPLYPILOT_CRAWL_CONCURRENCY=2

# Local LiteLLM response evidence (default: full; captures responses, NOT prompts).
# Returned content can still include personal data. Review locally before sharing.
# Values: full | metadata | off. Files: ~/.applypilot/logs/llm-responses/*.jsonl
# APPLYPILOT_LLM_RESPONSE_LOG=full
# APPLYPILOT_LLM_RESPONSE_MAX_CHARS=1048576

# DSPy / recursive context reasoning and trace-driven GEPA.
# Enabled by default. Claude Agent SDK owns the application agent; rlms runs
# generated Python in an isolated Docker container through the existing gateway.
APPLYPILOT_DSPY_ENABLED=true
# Leave APPLYPILOT_DSPY_TASKS unset for all registered tasks (including the browser).
# APPLYPILOT_DSPY_ARTIFACT_DIR=/absolute/private/path/ai-programs
APPLYPILOT_RLM_ENABLED=true
# Workspace-wide concurrent root sessions, shared with application helpers.
# Recursive child analysis stays within its root's admission slot.
# Above one session, one slot is reserved for finishing work and applications.
# Defaults to the shared resource worker count; set only for a separate cap.
# Memory pressure still pauses new task admission.
# APPLYPILOT_RLM_WORKERS=4
APPLYPILOT_RLM_THRESHOLD_CHARS=20000
# Browser results use exact excerpts plus archived pagination. Recursive
# perception remains available explicitly through read_browser_output.
APPLYPILOT_CONTEXT_RESULT_CHARS=8000
# Calls and iterations bound recursive work. Whole-run time limits are opt-in;
# zero allows provider recovery to finish and owner cancellation still applies.
# Optimization uses its shared round budget instead of nested limits.
# Large inputs use RLM; short inputs retain the direct DSPy path.
APPLYPILOT_RLM_MAX_CALLS=32
APPLYPILOT_RLM_MAX_ITERATIONS=24
APPLYPILOT_RLM_TIMEOUT_SECONDS=0
APPLYPILOT_RLM_PARALLEL_CALLS=2
# Per-cell CPU consumption; provider waits do not consume this allowance.
APPLYPILOT_RLM_CELL_CPU_SECONDS=60
# Provision before workers start: docker pull python:3.11-slim
# Containers never download packages or access the browser/network.
APPLYPILOT_RLM_DOCKER_IMAGE=python:3.11-slim
# Capture is local/private. Optimization sends evidence to the configured gateway.
# Autopilot supervises learning automatically; no separate enable/watch command is needed.
# LiteLLM owns provider recovery; exhausted rounds retry after the interval below.
# Saved CLI/dashboard overrides win over these defaults; `applypilot learning defaults` clears them.
APPLYPILOT_LEARNING_CAPTURE=true
# full = optimize + automatically promote passing candidates, including judged/proxy evidence.
# optimize = evaluate candidates, promote manually. capture = no optimization.
# Full mode sends relevant private corpus evidence to your configured gateway and uses models.
# Judged/proxy evaluations can be wrong; this is NOT verified end-to-end success.
APPLYPILOT_LEARNING_MODE=full
# Optional per-flag overrides (omit to follow MODE):
# APPLYPILOT_LEARNING_ENABLED=true
# APPLYPILOT_LEARNING_AUTO_PROMOTE=true
# APPLYPILOT_LEARNING_ALLOW_JUDGED_PROMOTION=true
APPLYPILOT_LEARNING_MIN_EXAMPLES=30
APPLYPILOT_LEARNING_METRIC_CALLS=40
APPLYPILOT_LEARNING_MAX_CALLS=80
APPLYPILOT_LEARNING_TIMEOUT_SECONDS=0
APPLYPILOT_LEARNING_REPLAY_TIMEOUT_SECONDS=0
APPLYPILOT_LEARNING_MAX_OUTPUT_TOKENS=327680
APPLYPILOT_LEARNING_COOLDOWN_SECONDS=21600
# Retry failed rounds automatically after gateway recovery is exhausted.
APPLYPILOT_LEARNING_RETRY_SECONDS=300

# One-command startup (applypilot start). CLI --no-open overrides browser launch.
APPLYPILOT_WEB_PORT=8765
APPLYPILOT_OPEN_DASHBOARD=true
APPLYPILOT_START_DASHBOARD_WAIT_SECONDS=20
# Existing saved learning choices override MODE; use `applypilot learning defaults`
# once to return to the environment defaults. This never deletes learned revisions.

# GitHub backup defaults. Explicit true authorizes uploads to your PRIVATE repo;
# set repository, GitHub auth and recovery key first. Keep the key off-device.
# Saved Backups settings win. Full encrypted snapshots remain the default scope.
APPLYPILOT_BACKUP_ENABLED=false

# Outreach reuses connected accounts. Set false to turn networking off.
APPLYPILOT_OUTREACH_ENABLED=true
APPLYPILOT_BACKUP_REPOSITORY=
APPLYPILOT_BACKUP_STATIC_MINUTES=5
APPLYPILOT_BACKUP_SNAPSHOT_HOURS=6
APPLYPILOT_BACKUP_INCLUDE_DOCUMENTS=true

# pgembed PostgreSQL persistence. No SQLite files are opened or imported.
# APPLYPILOT_PGDATA=/absolute/private/path/postgres/cluster-v1
# Optional external PostgreSQL instead of an embedded provider (dedicated DB):
# APPLYPILOT_DATABASE_URL=postgresql://ROLE:PASSWORD@HOST:5432/FRESH_DATABASE
APPLYPILOT_SQL_SECONDS=15
APPLYPILOT_DASHBOARD_SQL_SECONDS=5
# Each process starts with one connection; auto sets its maximum to 2 * workers + 8.
# A positive integer is a minimum; automatic sizing raises it as workers increase.
# Starting workers resizes existing process pools. Embedded PostgreSQL startup
# capacity follows worker demand within CPU/RAM bounds; server changes apply on restart.
APPLYPILOT_DB_POOL_SIZE=auto
# Shared Dask execution threads for preparation, applications and services.
# Any positive integer; restart after changing.
# APPLYPILOT_RESOURCE_WORKERS=4
# Concurrent browser tasks (at most the shared worker count, default up to two).
# APPLYPILOT_BROWSER_WORKERS=2
# Cap outstanding preparation operations, including queued Futures. Default:
# max(4, 2 * resource_workers). Browser holds block only browser phases.
# APPLYPILOT_PREPARATION_MAX_PENDING=8
# Salary is optional post-commit enrichment, never part of scoring's critical path.
APPLYPILOT_SALARY_ENRICHMENT=false

# Bound agent decisions instead of killing slow, active sessions. Ownership,
# cancellation, browser failures and the submission guard still end sessions.
APPLYPILOT_AGENT_MAX_TURNS=128
# Optional owner time limits (seconds); 0 disables the timer.
APPLYPILOT_AGENT_JOB_TIMEOUT_SECONDS=0
APPLYPILOT_AGENT_PROGRESS_TIMEOUT_SECONDS=0
APPLYPILOT_AGENT_IDLE_TIMEOUT_SECONDS=0
# Browser challenge adapter. Use the browser's actual route for solver requests.
FLARESOLVERR_URL=http://127.0.0.1:8191
# APPLYPILOT_BROWSER_PROXY_URL=http://127.0.0.1:8080
